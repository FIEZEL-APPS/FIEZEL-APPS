{
  "$description": "FIEZEL design tokens v1.0 — 'WARM PAPER, BRIGHT MIND'. Format: W3C Design Tokens Community Group. Sinkron dengan tokens.css; nilai final pasca-koreksi WCAG (lihat WCAG.md).",
  "color": {
    "$type": "color",
    "surface": {
      "bg": { "$value": "#FFF9EE", "$description": "Background utama (Warm Paper)" },
      "panel": { "$value": "#FFFFFF", "$description": "Kartu/panel" },
      "panel-soft": { "$value": "#FFF3DC", "$description": "Tile lembut, chip, disabled surface" },
      "line": { "$value": "#F0E4CF", "$description": "Border kartu" },
      "line-soft": { "$value": "#F7EFDF", "$description": "Divider halus" }
    },
    "ink": {
      "text": { "$value": "#241A11", "$description": "Teks utama; juga permukaan CTA ink. 16,28:1 di bg" },
      "muted": { "$value": "#6E5E47", "$description": "Teks sekunder. 5,97:1 di bg" },
      "muted-soft": { "$value": "#7E6C4B", "$description": "Teks tersier. Digeser dari #857350 (4,39:1) ke 4,85:1 di bg agar lulus AA normal" }
    },
    "sun": {
      "sun": { "$value": "#FFC700", "$description": "Kuning kanon brand (Solar), naik dari #FFD23F. Ink di atasnya 10,90:1" },
      "sun-deep": { "$value": "#E6A800", "$description": "Hover permukaan sun (ink 8,10:1). BUKAN focus ring — gagal 3:1 non-teks" },
      "sun-press": { "$value": "#CC9600", "$description": "Press permukaan sun (ink 6,44:1)" },
      "sun-soft": { "$value": "#FFF3C4", "$description": "Tile/chip kuning lembut (ink 15,33:1)" }
    },
    "core": {
      "core": { "$value": "#1B1418", "$description": "Permukaan gelap hangat momen AI (Bright Mind) — dipakai hemat" },
      "core-soft": { "$value": "#2A2126", "$description": "Kartu di dalam panel AI" },
      "core-line": { "$value": "#3A3038", "$description": "Border di panel AI" },
      "on-core": { "$value": "#FDFAF3", "$description": "Teks utama di core. 17,37:1" },
      "on-core-muted": { "$value": "#FDFAF3AD", "$description": "Teks sekunder di core, alpha .68 (rgba 253,250,243,.68). Efektif 8,43:1 di core" }
    },
    "semantic": {
      "good": { "$value": "#1F6B4E", "$description": "Teks benar. Digeser dari #2E8B69 (3,80:1) ke 5,82:1 di good-soft" },
      "good-bright": { "$value": "#2E8B69", "$description": "HANYA ikon/teks >=18px (3,80:1 large-text)" },
      "good-soft": { "$value": "#E9F7F0" },
      "bad": { "$value": "#AC3E2A", "$description": "Teks salah. Digeser dari #B8432D (4,44:1) ke 4,95:1 di bad-soft" },
      "bad-bright": { "$value": "#B8432D", "$description": "HANYA ikon/teks >=18px" },
      "bad-soft": { "$value": "#FDE3DE" },
      "info": { "$value": "#7A5F1B", "$description": "Teks info. Digeser dari #8C6D1F (4,37:1) ke 5,42:1 di info-soft. Pengganti toast navy" },
      "info-soft": { "$value": "#FFF3C4" }
    },
    "state": {
      "ink-hover": { "$value": "#3A2B1C", "$description": "Hover CTA ink (krem di atasnya 12,99:1)" },
      "ink-press": { "$value": "#120C07", "$description": "Press CTA ink (krem 18,53:1)" },
      "focus-ring": { "$value": "#A67A00", "$description": "Token BARU: ring fokus 2px offset 2px. 3,71:1 vs bg / 3,89 vs panel / 3,53 vs panel-soft (>=3:1 non-teks)" },
      "focus-ring-on-core": { "$value": "#FFC700", "$description": "Ring fokus di panel AI gelap (11,57:1 vs core)" },
      "text-disabled": { "$value": "#75654C", "$description": "Teks disabled — 5,13:1 di panel-soft, jangan pakai opacity rendah; sertakan ikon gembok" },
      "surface-disabled": { "$value": "{color.surface.panel-soft}" },
      "line-disabled": { "$value": "{color.surface.line}" },
      "on-core-disabled": { "$value": "#FDFAF385", "$description": "Alpha .52 di core, efektif ±6,1:1" }
    }
  },
  "gradient": {
    "sun-grad": {
      "$type": "gradient",
      "$description": "CTA dimensional 180deg. Ink di stop terang 12,87:1, di stop gelap 8,64:1",
      "$value": [
        { "color": "#FFDE59", "position": 0 },
        { "color": "#FFA500", "position": 1 }
      ]
    }
  },
  "dimension": {
    "$type": "dimension",
    "radius-lg": { "$value": "24px" },
    "radius-md": { "$value": "16px" },
    "radius-sm": { "$value": "12px" },
    "radius-pill": { "$value": "999px" },
    "focus-ring-width": { "$value": "2px" },
    "focus-ring-offset": { "$value": "2px" },
    "tap-min": { "$value": "44px", "$description": "Touch target minimum semua kontrol" },
    "mascot-dock": { "$value": "88px", "$description": "Slot maskot kanan-bawah — tak boleh menutupi konten interaktif" }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-sm": { "$value": { "color": "#241A110F", "offsetX": "0px", "offsetY": "2px", "blur": "10px", "spread": "0px" } },
    "shadow-md": { "$value": { "color": "#241A1117", "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "0px" } },
    "shadow-lg": { "$value": { "color": "#241A1126", "offsetX": "0px", "offsetY": "24px", "blur": "60px", "spread": "0px" } }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "display": { "$value": ["FZ Fredoka", "Fredoka", "FZ Plus Jakarta Sans", "sans-serif"], "$description": "HANYA display & judul layar; judul kartu/UI pakai body 700" },
    "body": { "$value": ["FZ Plus Jakarta Sans", "Plus Jakarta Sans", "-apple-system", "SF Pro", "Inter", "sans-serif"] }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700, "$description": "Weight maksimum — 650/750/800 (faux-bold) dilarang" }
  },
  "typography": {
    "$type": "typography",
    "$description": "Skala mobile. LANTAI 12px — tak ada teks lebih kecil (perbaikan audit: eyebrow 7–10px dihapus)",
    "display": { "$value": { "fontFamily": "{fontFamily.display}", "fontSize": "28px", "fontWeight": "{fontWeight.semibold}", "lineHeight": 1.15 } },
    "h1": { "$value": { "fontFamily": "{fontFamily.display}", "fontSize": "22px", "fontWeight": "{fontWeight.semibold}", "lineHeight": 1.2 } },
    "h2": { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "18px", "fontWeight": "{fontWeight.bold}", "lineHeight": 1.25 } },
    "body": { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "15px", "fontWeight": "{fontWeight.regular}", "lineHeight": 1.55 } },
    "label": { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "13px", "fontWeight": "{fontWeight.semibold}", "lineHeight": 1.3 } },
    "micro": { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "12px", "fontWeight": "{fontWeight.semibold}", "lineHeight": 1.3, "letterSpacing": "0.08em" }, "$description": "Eyebrow/nav — lantai absolut" },
    "data": { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "28px", "fontWeight": "{fontWeight.bold}", "lineHeight": 1.1 }, "$description": "Angka data — tabular-nums" }
  },
  "cubicBezier": {
    "$type": "cubicBezier",
    "ease": { "$value": [0.22, 0.8, 0.28, 1] },
    "ease-spring": { "$value": [0.34, 1.4, 0.4, 1] }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "160ms" },
    "med": { "$value": "260ms" },
    "slow": { "$value": "420ms" }
  },
  "dark": {
    "$description": "fase 2 — mode gelap penuh dirancang belakangan; jangan isi ad-hoc"
  }
}
