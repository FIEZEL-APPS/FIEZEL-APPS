mnNumber:7},void 0)]},void 0,!0,{fileName:"/app/applet/features/voice-studio/src/components/BeginnerAnswerAssistant.tsx",lineNumber:57,columnNumber:5},void 0)},Eae=[{match:"where do you live",pronunciation:"Hai der! Nais tu tok wit yu tudei. Wer du yu liv, end hu du yu liv wit et hom?",translationId:"Halo! Senang mengobrol denganmu hari ini. Di mana rumahmu (tempat tinggalmu), dan dengan siapa kamu tinggal di rumah?",translationTh:"สวัสดีครับ! ดีใจที่ได้คุยกันวันนี้ บ้านของคุณอยู่ที่ไหน และที่บ้านอาศัยอยู่กับใครครับ?"},{match:"what is your favorite place near your house",pronunciation:"Det sauns laik e lav-li pleis tu liv! Wot iz yer fei-vrit pleis nier yer haus, laik e park or e lokal kafe?",translationId:"Terdengar seperti tempat yang nyaman untuk ditinggali! Apa tempat favorit di dekat rumahmu, seperti taman atau kafe lokal?",translationTh:"ฟังดูเป็นสถานที่ที่น่าอยู่มากเลยครับ! สถานที่โปรดใกล้ๆ บ้านของคุณคือที่ไหนเหรอ เช่น สวนสาธารณะหรือคาเฟ่?"},{match:"how long have you lived there",pronunciation:"Det sauns laik e lav-li nei-ber-hud! Heving plei-ses laik det nier yer haus iz ve-ri kon-vi-ni-ent. Hau long hev yu livd der?",translationId:"Terdengar seperti lingkungan yang sangat nyaman! Punya tempat seperti itu di dekat rumah pasti memudahkan. Sudah berapa lama kamu tinggal di sana?",translationTh:"ฟังดูเป็นย่านที่น่าอยู่มากเลย! มีสถานที่แบบนั้นอยู่ใกล้บ้านคงสะดวกมาก คุณอาศัยอยู่ที่นั่นมานานแค่ไหนแล้ว?"},{match:"what do you usually do there on weekends",pronunciation:"Going der sounds so ri-lek-sing! Wot du yu yu-zju-e-li du der on wik-ends, end hu du yu go wit?",translationId:"Pergi ke sana terdengar sangat menenangkan! Apa yang biasanya kamu lakukan di sana saat akhir pekan, dan bersama siapa kamu pergi?",translationTh:"การไปที่นั่นฟังดูผ่อนคลายมากเลย! ปกติคุณทำอะไรที่นั่นในวันหยุดสุดสัปดาห์ และไปกับใครครับ?"},{match:"what would you like to drink today",pronunciation:"Hey der! Gud tu si yu et de kafe. Wot wud yu laik tu dringk tudei, end wot ar yu duing after awer kofi?",translationId:"Halo! Senang bertemu kamu di kafe. Kamu ingin minum apa hari ini, dan apa rencanamu setelah kita ngopi?",translationTh:"สวัสดี! ดีใจที่ได้เจอกันที่คาเฟ่ วันนี้คุณอยากดื่มอะไร และหลังจากดื่มกาแฟเสร็จคุณมีแผนจะทำอะไรต่อ?"},{match:"what is your presentation topic about",pronunciation:"Wan ais la-tei kaming rait ap! Best of lak pri-pering yer pre-zen-tei-syen. Wot iz yer pre-zen-tei-syen topik ebaut?",translationId:"Satu es kopi susu segera siap! Semoga sukses menyiapkan presentasi bersama timmu sore ini. Apa topik presentasi kalian?",translationTh:"ลาเต้เย็น 1 แก้วได้แล้วครับ! ขอให้การเตรียมงานนำเสนอกับทีมช่วงบ่ายนี้ราบรื่นนะ หัวข้อที่นำเสนอเกี่ยวกับเรื่องอะไรครับ?"},{match:"what are you and your friend studying at the library",pronunciation:"Got it, wan hot kofi kaming ap! Wot ar yu end yer frend stadi-ing et de lai-bre-ri?",translationId:"Siap, satu kopi panas! Apa yang akan kamu pelajari bersama temanmu di perpustakaan?",translationTh:"รับทราบ กาแฟร้อน 1 แก้วครับ! วันนี้จะไปติววิชาอะไรกับเพื่อนที่ห้องสมุดเอ่ย?"},{match:"what topics are you covering today",pronunciation:"Kaming rait ap! En ais la-tei iz e greit cois bi-for stadi-ing. Wot topiks ar yu ka-ve-ring tudei?",translationId:"Segera disiapkan! Pilihan minuman yang tepat sebelum belajar. Topik atau materi apa yang sedang kamu bahas hari ini?",translationTh:"ได้เลยครับ! เป็นตัวเลือกที่ดีมากก่อนไปอ่านหนังสือ วันนี้คุณกำลังทบทวนหัวข้ออะไรอยู่เหรอ?"},{match:"how long are you staying at the library",pronunciation:"Nais! Tu meik de sen-tens kom-plit, yu ken sei det. Hau long ar yu stei-ing et de lai-bre-ri tudei?",translationId:"Bagus! Berapa lama kamu berencana belajar di perpustakaan hari ini?",translationTh:"ดีเลย! วันนี้คุณวางแผนจะอ่านหนังสือที่ห้องสมุดนานแค่ไหนครับ?"},{match:"when is your presentation",pronunciation:"Det iz e ve-ri in-tres-ting topik! Wen iz yer pre-zen-tei-syen, end hau du yu fil ebaut it?",translationId:"Itu topik yang sangat menarik! Kapan jadwal presentasimu, dan bagaimana perasaanmu mempersiapkannya?",translationTh:"นั่นเป็นหัวข้อที่น่าสนใจมาก! คุณต้องนำเสนอเมื่อไหร่ และรู้สึกอย่างไรบ้างกับการเตรียมตัว?"},{match:"where did you go, and what was the best part",pronunciation:"Welkam bek! Ai herd yu tuk e syort trip last wik-end. Wer did yu go, end wot woz de best part of yer wik-end?",translationId:"Selamat datang kembali! Kudengar kamu sempat bepergian akhir pekan lalu. Ke mana kamu pergi, dan apa bagian paling seru dari akhir pekanmu?",translationTh:"ยินดีต้อนรับกลับ! ได้ข่าวว่าสุดสัปดาห์ก่อนคุณไปเที่ยวมา ไปที่ไหนมาครับ และอะไรคือส่วนที่ประทับใจที่สุด?"},{match:"which dish was your favorite",pronunciation:"Det sauns laik en o-sem wik-end! Strit fud in de maun-ten er iz de best. Wic disy woz yer fei-vrit?",translationId:"Terdengar seperti akhir pekan yang luar biasa! Kuliner lokal memang paling nikmat. Hidangan mana yang paling kamu sukai?",translationTh:"ฟังดูเป็นวันหยุดสุดสัปดาห์ที่ยอดเยี่ยมเลย! ชอบเมนูไหนมากที่สุดครับ?"},{match:"who did you go with",pronunciation:"Det sauns laik e wan-der-ful wik-end! Hu did yu go wit, end wot woz yer fei-vrit part?",translationId:"Terdengar seperti akhir pekan yang menyenangkan! Bersama siapa kamu pergi ke sana, dan apa bagian favoritmu?",translationTh:"ฟังดูเป็นวันหยุดสุดสัปดาห์ที่ยอดเยี่ยมมาก! คุณไปเที่ยวกับใคร และชอบส่วนไหนมากที่สุด?"},{match:"would you like to visit there again",pronunciation:"Det fud sauns so di-li-syes! Wud yu laik tu vi-zit der e-gen nekst ho-li-dei?",translationId:"Makanan itu terdengar sangat lezat! Apakah kamu ingin berkunjung ke sana lagi pada liburan berikutnya?",translationTh:"อาหารฟังดูน่าอร่อยมาก! วันหยุดครั้งหน้าคุณอยากกลับไปเที่ยวที่นั่นอีกไหม?"},{match:"do you think remote work increases productivity",pronunciation:"Let as muv on tu Part Tri. Du yu tingk ri-mot werk in-kri-ses pro-dak-ti-vi-ti, or daz it wi-ken tiim ko-la-bo-rei-syen?",translationId:"Mari lanjut ke Bagian 3. Menurutmu apakah kerja jarak jauh meningkatkan produktivitas, atau justru melemahkan kolaborasi tim?",translationTh:"มาต่อกันที่ส่วนที่ 3 คุณคิดว่าการทำงานทางไกลช่วยเพิ่มประสิทธิภาพ หรือทำให้ความร่วมมือในทีมลดลง?"},{match:"regulate remote work hours",pronunciation:"Ek-se-lent poin. Du yu tingk ga-vern-ments syud re-gyu-leit ri-mot werk awers in de fyu-cer?",translationId:"Poin yang sangat tajam. Menurutmu apakah pemerintah atau perusahaan perlu mengatur jam kerja jarak jauh di masa depan?",translationTh:"เป็นประเด็นที่ยอดเยี่ยมมาก คุณคิดว่ารัฐบาลหรือบริษัทควรกำหนดชั่วโมงการทำงานทางไกลในอนาคตไหม?"},{match:"allow hybrid schedules in the future",pronunciation:"Ek-se-lent poin. Du yu tingk kam-pe-nis syud e-lau hai-brid ske-juls in de fyu-cer?",translationId:"Poin yang sangat baik. Menurutmu apakah perusahaan sebaiknya menerapkan jadwal kerja hibrida di masa depan?",translationTh:"ประเด็นยอดเยี่ยมมาก คุณคิดว่าบริษัทควรใช้รูปแบบการทำงานแบบไฮบริดในอนาคตไหม?"},{match:"いらっしゃいませ！ご注文はお決まりですか",pronunciation:"Irasshaimase! Go-chuumon wa o-kimari desu ka? Kyou no o-susume wa hotto koohii to chiizukeeki desu yo.",translationId:"Selamat datang! Apakah pesanan Anda sudah ditentukan? Rekomendasi hari ini adalah kopi panas dan cheesecake.",translationTh:"ยินดีต้อนรับค่ะ! รับอะไรดีคะ? เมนูแนะนำวันนี้คือกาแฟร้อนกับชีสเค้กค่ะ"},{match:"店内でお召し上がりですか",pronunciation:"Kashikomarimashita! Hotto koohii to chiizukeeki desu ne. Tennai de o-meshiagari desu ka?",translationId:"Baik, pesanan diterima! Apakah ingin dinikmati di dalam kafe (makan di sini), atau dibawa pulang?",translationTh:"รับทราบค่ะ! จะรับประทานที่ร้าน หรือรับกลับบ้านดีคะ?"},{match:"お砂糖とミルクはお使いになりますか",pronunciation:"Hotto koohii desu ne! O-satou to miruku wa o-tsukai ni narimasu ka?",translationId:"Baik, kopi panas ya! Apakah Anda ingin menggunakan gula dan susu?",translationTh:"กาแฟร้อนนะคะ! รับน้ำตาลกับนมด้วยไหมคะ?"},{match:"ごゆっくりどうぞ",pronunciation:"Kashikomarimashita! O-seki made o-mochi shimasu node, go-yukkuri douzo. Kyou wa kore kara o-dekake desu ka?",translationId:"Baik! Pesanan akan kami antar ke meja