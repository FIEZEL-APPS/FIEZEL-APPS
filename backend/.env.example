# Salin jadi `.env` di sebelah berkas ini, lalu isi. JANGAN commit `.env`.
#
# KETUJUH DI BAWAH WAJIB. backend/db.py dan backend/auth.py membacanya dengan
# os.environ["NAMA"] — bukan .get() — jadi yang kurang membuat server MATI SAAT
# START, bukan jalan setengah. Itu disengaja: pemasangan separuh lebih berbahaya
# daripada pemasangan yang menolak menyala.
#
# tests/backend-env-contract-test.js menjaga berkas ini tetap sepadan dengan kode:
# menambah os.environ["X"] baru di backend tanpa menambahkannya di sini = CI merah.

# ── Database ────────────────────────────────────────────────────────────────────
# MongoDB TIDAK BISA dipasang di shared hosting cPanel. Pakai MongoDB Atlas
# (tier gratis cukup untuk memulai). Ambil dari Atlas > Connect > Drivers.
# Jangan lupa Network Access: izinkan IP server hostingmu.
MONGO_URL=mongodb+srv://pengguna:sandi@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fiezel

# ── Akun owner ──────────────────────────────────────────────────────────────────
# Dipakai seed_owner(). CATATAN PENTING: env adalah sumber kebenaran — setiap kali
# bootstrap.py dijalankan, sandi owner DISELARASKAN ke nilai di bawah. Itu juga
# cara sah memulihkan sandi yang lupa: ubah di sini, jalankan bootstrap.py lagi.
ADMIN_EMAIL=kamu@contoh.com
ADMIN_PASSWORD=ganti-dengan-sandi-panjang-dan-acak

# ── Rahasia ─────────────────────────────────────────────────────────────────────
# Keduanya harus acak dan panjang. Bangkitkan dengan:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET yang bocor = siapa pun bisa memalsukan sesi murid dan guru.
JWT_SECRET=
OWNER_MASTER_TOKEN=

# ── Login Google ────────────────────────────────────────────────────────────────
# Alamat layanan penukar sesi Google. auth.py melarang keras menanam nilainya di
# kode atau memberinya fallback ("DO NOT HARDCODE THE URL"), jadi tempatnya di sini.
EMERGENT_AUTH_SESSION_URL=

# ── CORS ────────────────────────────────────────────────────────────────────────
# Daftar origin yang boleh memanggil API ini dari browser, dipisah koma.
#
# KOSONG = TIDAK ADA yang diizinkan lintas-situs. Itu bawaan yang disengaja dan
# gagal-tertutup; isi dengan asalmu sendiri. Untuk pemasangan di fiezel.my.id:
CORS_ORIGINS=https://fiezel.my.id
#
# Menulis "*" di sini masih boleh untuk pengembangan lokal, dan kalau kamu
# melakukannya server MEMATIKAN kredensial secara otomatis — "terbuka untuk semua"
# dan "bawa cookie" tidak pernah boleh benar bersamaan. Alasan lengkapnya, berikut
# hasil pengukurannya, ada di komentar CORS di backend/server.py.
