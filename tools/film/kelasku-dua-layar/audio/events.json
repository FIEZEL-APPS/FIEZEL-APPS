 "VO": [
  {
   "id": "01",
   "at": 0.3,
   "text": "Tiga puluh dua murid. Satu guru.",
   "style": "pelan, hangat, seperti membuka cerita",
   "max": 2.25
  },
  {
   "id": "02",
   "at": 2.7,
   "text": "Siapa yang diam-diam tertinggal?",
   "style": "bertanya lirih, ikut peduli",
   "max": 2.15
  },
  {
   "id": "03",
   "at": 5,
   "text": "KelasKu punya jawabannya.",
   "say": "Kelasku punya jawabannya.",
   "style": "yakin, hangat, sedikit tersenyum",
   "max": 2.25
  },
  {
   "id": "04",
   "at": 7.4,
   "text": "Buat kelas, bagikan satu kode.",
   "style": "jelas, ringan",
   "max": 2.25
  },
  {
   "id": "05",
   "at": 9.8,
   "text": "Murid mengetik kode, lalu Gabung.",
   "style": "jelas, ringan",
   "max": 2.25
  },
  {
   "id": "06",
   "at": 12.2,
   "text": "Kamu yang menyetujui siapa masuk.",
   "style": "tenang, meyakinkan",
   "max": 2.25
  },
  {
   "id": "07",
   "at": 14.6,
   "text": "Kirim tugas atau ujian mini. Sekali ketuk, sampai ke semua murid.",
   "style": "bersemangat tapi tenang",
   "max": 4.65
  },
  {
   "id": "08",
   "at": 19.4,
   "text": "Murid mengerjakannya di KelasKu.",
   "say": "Murid mengerjakannya di Kelasku.",
   "style": "ringan",
   "max": 2.25
  },
  {
   "id": "09",
   "at": 21.8,
   "text": "Hasilnya pulang sendiri.",
   "style": "puas, tersenyum",
   "max": 2.25
  },
  {
   "id": "10",
   "at": 24.2,
   "text": "Saat ujian, pindah layar pun tercatat.",
   "style": "tegas, tenang",
   "max": 2.25
  },
  {
   "id": "11",
   "at": 26.6,
   "text": "Tiap pagi, KelasKu memberi tahu siapa yang perlu disapa.",
   "say": "Tiap pagi, Kelasku memberi tahu siapa yang perlu disapa.",
   "style": "hangat, penuh perhatian",
   "max": 4.65
  },
  {
   "id": "12",
   "at": 31.4,
   "text": "Pesannya sudah tertulis. Tinggal kirim.",
   "style": "ringan, tersenyum",
   "max": 2.25
  },
  {
   "id": "13",
   "at": 33.8,
   "text": "Sekali lihat, tahu siapa butuh apa.",
   "style": "yakin",
   "max": 2.25
  },
  {
   "id": "14",
   "at": 36.2,
   "text": "Bukan cuma nilai, tapi letak salahnya.",
   "style": "tegas, jelas",
   "max": 2.25
  },
  {
   "id": "15",
   "at": 38.6,
   "text": "Kelompok belajar tersusun sendiri.",
   "style": "ringan",
   "max": 2.25
  },
  {
   "id": "16",
   "at": 41,
   "text": "Remedial dan pengayaan, otomatis.",
   "style": "ringkas, mantap",
   "max": 2.25
  },
  {
   "id": "17",
   "at": 43.4,
   "text": "Laporan orang tua, jadi sendiri.",
   "style": "ringan, tersenyum",
   "max": 2.25
  },
  {
   "id": "18",
   "at": 45.8,
   "text": "Absensi dan rekap e-Rapor, beres.",
   "say": "Absensi dan rekap e-rapor, beres.",
   "style": "ringkas, lega",
   "max": 2.25
  },
  {
   "id": "19",
   "at": 48.2,
   "text": "Kurikulum Merdeka, langsung jadi tugas.",
   "style": "yakin",
   "max": 2.25
  },
  {
   "id": "20",
   "at": 50.6,
   "text": "Braincore menyarankan. Kamu yang memutuskan.",
   "say": "Brein-kor menyarankan. Kamu yang memutuskan.",
   "style": "tenang, menghormati guru",
   "max": 2.75
  },
  {
   "id": "21",
   "at": 53.5,
   "text": "Murid pun melihat langkah belajarnya.",
   "style": "hangat",
   "max": 1.75
  },
  {
   "id": "22",
   "at": 55.4,
   "text": "Dan waktumu kembali untuk mengajar.",
   "style": "hangat, lega, sedikit lebih pelan",
   "max": 2.25
  },
  {
   "id": "23",
   "at": 57.8,
   "text": "Satu kelas. Dua layar. Terhubung.",
   "style": "mantap, pelan, penuh jeda di tiap titik",
   "max": 4.13
  },
  {
   "id": "24",
   "at": 66.6,
   "text": "Buka Demo Guru di fiezel.my.id.",
   "say": "Buka Demo Guru, di fiezel titik my titik id.",
   "style": "ramah, jelas, mengajak",
   "max": 4.65
  }
 ],
