/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# HTML pages: Wajib revalidasi agar setiap pembaruan HTML & query string aset langsung aktif seketika
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/th/
  Cache-Control: public, max-age=0, must-revalidate
/install/
  Cache-Control: public, max-age=0, must-revalidate
/th/install/
  Cache-Control: public, max-age=0, must-revalidate
/promo/
  Cache-Control: public, max-age=0, must-revalidate
/privacy/
  Cache-Control: public, max-age=0, must-revalidate
/terms/
  Cache-Control: public, max-age=0, must-revalidate
/th/privacy/
  Cache-Control: public, max-age=0, must-revalidate
/th/terms/
  Cache-Control: public, max-age=0, must-revalidate
# Service Worker & Version Metadata: Wajib no-cache agar update terdeteksi instan
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/app/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/version.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/app/version.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/VERSION.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/app/VERSION.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/version.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
/app/version.json
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

# Static assets dengan cache-busting version query string
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
